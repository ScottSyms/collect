job "ais-parse" {
  datacenters = ["dc1"]
  type        = "batch"

  periodic {
    cron             = "*/1 * * * * *"
    prohibit_overlap = true
  }

  group "decode" {
    count = 1

    task "ais-parse" {
      driver = "exec"

      config {
        command = "local/ais-parse"
        args = [
          "--input-s3-bucket", "collections/norway-norm",
          "--output-s3-bucket", "collections/ais",
          "--incremental",
          "--concurrency", "4",
        ]
      }

      artifact {
        source      = "http://192.168.99.107:9000/binaries/ais-parse"
        destination = "local/ais-parse"
        mode        = "file"
      }

      # Fixed 2026: was reading "norway-norm" / writing "ais" (bare buckets).
      # ais-normalize was writing nowhere useful (see its job file), so this
      # had nothing new to process. Now reads ais-normalize's fixed output.
      env {
        S3_ENDPOINT    = "http://192.168.99.107:9000"
        S3_REGION      = "us-east-1"
        S3_ACCESS_KEY  = "qz5mjYcOvTgRIw6aJKgm"
        S3_SECRET_KEY  = "uIDVBTY5eux1xgmiWqnLU6LfnjI1wYgCyrJuYggl"
        S3_DISABLE_TLS = "true"
      }

      resources {
        cpu    = 500
        memory = 1024
      }

      restart {
        attempts = 3
        interval = "5m"
        delay    = "15s"
        mode     = "delay"
      }
    }
  }
}
