job "ais-normalize" {
  datacenters = ["dc1"]
  type        = "batch"

  periodic {
    cron             = "*/1 * * * * *"
    prohibit_overlap = true
  }

  group "normalize" {
    count = 1

    task "ais-normalize" {
      driver = "exec"

      config {
        command = "local/ais-normalize"
        args = [
          "--input-s3-bucket", "collections/norway",
          "--input-s3-bucket", "collections/duplicate",
          "--output-s3-bucket", "collections/norway-norm",
          "--incremental",
          "--concurrency", "4",
        ]
      }

      artifact {
        source      = "http://192.168.99.107:9000/binaries/ais-normalize"
        destination = "local/ais-normalize"
        mode        = "file"
      }

      # Fixed 2026: was reading "norway"/"duplicate" (bare buckets), which
      # nothing has written to since collection moved to the "duncan"
      # datacenter under the collections/ prefix (see nomad-collect-norway-prod,
      # nomad-collect-duplicate-prod). This job was processing nothing.
      env {
        S3_ENDPOINT    = "http://192.168.99.107:9000"
        S3_REGION      = "us-east-1"
        S3_ACCESS_KEY  = "qz5mjYcOvTgRIw6aJKgm"
        S3_SECRET_KEY  = "uIDVBTY5eux1xgmiWqnLU6LfnjI1wYgCyrJuYggl"
        S3_DISABLE_TLS = "true"
      }

      resources {
        cpu    = 500
        memory = 1024
      }

      restart {
        attempts = 3
        interval = "5m"
        delay    = "15s"
        mode     = "delay"
      }
    }
  }
}
