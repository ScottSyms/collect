job "collect-orchestrator" {
  datacenters = ["dc1"]
  type        = "service"

  group "orchestrator" {
    count = 1

    network {
      port "http" { to = 8080 }
    }

    service {
      name = "collect-orchestrator"
      port = "http"
      check {
        type     = "http"
        path     = "/healthz"
        interval = "10s"
        timeout  = "5s"
      }
    }

    task "orchestrator" {
      driver = "exec"
      config {
        command = "local/collect-orchestrator"
        args = [
          "--listen-addr", "0.0.0.0:${NOMAD_PORT_http}",
          "--input-s3-bucket", "collections",
          "--input-s3-prefix", "bronze",
          "--iceberg-catalog-uri", "http://lakekeeper.service.consul:8181/catalog",
          "--iceberg-warehouse", "s3://warehouse",
          "--iceberg-namespace", "ais",
        ]
      }
      artifact {
        source      = "http://192.168.99.107:9000/binaries/collect-orchestrator"
        destination = "local/collect-orchestrator"
        mode        = "file"
      }
      env {
        DATABASE_URL = "postgresql://postgres:postgres@db.service.consul:5432/postgres"
        S3_ENDPOINT  = "http://192.168.99.107:9000"
        S3_REGION    = "us-east-1"
        S3_ACCESS_KEY = "qz5mjYcOvTgRIw6aJKgm"
        S3_SECRET_KEY = "uIDVBTY5eux1xgmiWqnLU6LfnjI1wYggl"
        S3_DISABLE_TLS = "true"
        MAX_INFLIGHT = "4"
        INGEST_TOKEN = "changeme"
        # Nomad batch dispatch (off by default; set ENABLE_DISPATCH=true to use parse-file dispatch)
        ENABLE_DISPATCH        = "false"
        NOMAD_ADDR             = "http://nomad.service.consul:4646"
        NOMAD_JOB              = "parse-file"
        DISPATCH_CONCURRENCY   = "32"
        DISPATCH_RECLAIM_SECS  = "1800"
        CALLBACK_TOKEN         = "changeme"
        RUST_LOG = "info"
      }
      resources {
        cpu    = 500
        memory = 1024
      }
    }
  }
}

# RustFS webhook – S3 bucket notification to orchestrator
# Configure via mc or RustFS admin API (MinIO-compatible):
#   mc alias set rustfs http://192.168.99.107:9000 qz5mjYcOvTgRIw6aJKgm uIDVBTY5eux1xgmiWqnLU6LfnjI1wYgCyrJuYggl
#   mc event add rustfs/collections arn:minio:sqs::1:webhook --event put --prefix bronze/ --suffix .parquet
#   # RustFS NOTIFY_WEBHOOK endpoint must point at collect-orchestrator:
#   # NOTIFY_WEBHOOK_ENABLE=on NOTIFY_WEBHOOK_ENDPOINT=http://collect-orchestrator.service.consul:8080/ingest
#   # NOTIFY_WEBHOOK_AUTH_TOKEN=changeme
# For local docker-compose the webhook is pre-wired if you enable the rustfs service.
